# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def isPalindrome(self, head: ListNode | None) -> bool:
        slow=head
        array=[]
        while slow!=None:
            array.append(slow.val)
            slow=slow.next
        for i in range(len(array)//2):
            if array[i]!=array[len(array)-1-i]:
                return False
        return True

class Solution:
    def square(self, num):
        ans = 0
        while num != 0:
            x = num % 10
            ans += x * x
            num //= 10          
        return ans

    def isHappy(self, n: int) -> bool:
        slow = self.square(n)                   
        fast = self.square(self.square(n))       
        while fast != 1 and slow != fast:
            slow = self.square(slow)
            fast = self.square(self.square(fast))
        return fast == 1

class Solution:
    def detectCapitalUse(self, word: str) -> bool:
        if word.upper()==word:
            return True
        elif word.lower()==word:
            return True
        else:
            if word[0]==word[0].upper():
                if word[1:len(word)]==word[1:len(word)].lower():
                    return True
                else:
                    return False    
            else:
                return False        

        

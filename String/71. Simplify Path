class Solution:
    def simplifyPath(self, path: str) -> str:
        stack=[]
        name=""
        for ch in path+"/":
            if ch=="/":
                if name=="..":
                    if stack:
                        stack.pop()
                elif name!="" and name!=".":
                    stack.append(name)
                name=""    
            else :
                name+=ch           
        return "/"+"/".join(stack)        

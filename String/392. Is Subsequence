class Solution:
    def isSubsequence(self, s: str, t: str) -> bool:
        if s=="":
            return True
        seen=list(s[:len(s)])
        left=0
        for i in range(len(t)):
            if left==len(s):
                break
            if t[i]==seen[left]:
                left+=1
        return left==len(seen)         

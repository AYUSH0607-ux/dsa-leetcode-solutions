class Solution:
    def leftRightDifference(self, nums: List[int]) -> List[int]:
        left_sum=0
        answer=[]
        total=sum(nums)
        for i in range(len(nums)):
            right_sum=total-left_sum-nums[i]
            answer.append(abs(left_sum-right_sum))
            left_sum+=nums[i]
        return answer    


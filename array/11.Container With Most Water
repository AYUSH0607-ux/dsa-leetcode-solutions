class Solution(object):
    def maxArea(self, height):
        max=0
        left=0
        right=len(height)-1
        while left<right:
            current=min(height[left],height[right])*(right-left)
            if max<current:
                max=current
            if height[left]<height[right]   :
                left+=1
            else:
                right-=1     

        return max        
        

class Solution:
    def longestSubarray(self, nums: list[int]) -> int:
        maximum,left,zero_count=0,0,0
        subarray=[]
        for right in range(len(nums)):
            if nums[right]==0:
                zero_count+=1
            while zero_count>1:
                if nums[left]==0:
                    zero_count-=1
                left+=1
            maximum=max(maximum,right-left)        
        return maximum

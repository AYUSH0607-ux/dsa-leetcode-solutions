class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        m=len(nums1)
        n=len(nums2)
        i,j=0,0
        res=[]
        while i<m and j<n:
            if nums1[i]<nums2[j]:
                res.append(nums1[i])
                i+=1
            else :
                res.append(nums2[j])
                j+=1
        while i<m:
            res.append(nums1[i])
            i+=1
        while j<n:
            res.append(nums2[j])
            j+=1 
        total=len(res)
        med=total//2
        if total%2==0:
            return (res[med-1]+res[med])/2
        else:
            return res[med]
            

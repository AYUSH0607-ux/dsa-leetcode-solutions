class Solution:
    def isValidSudoku(self, board: List[List[str]]) -> bool:
        for i in range(9):
            res=[]
            res1=[]
            for j in range(9):
                if board[i][j] not in res:
                    res.append(board[i][j])
                else :
                    if board[i][j]==".":
                        continue
                    else:    
                        return False
            for j in range(9):
                if board[j][i] not in res1:
                    res1.append(board[j][i])
                else :
                    if board[j][i]==".":
                        continue
                    else:    
                        return False
        for k in range(0,9,3):
            for l in range(0,9,3):
                box=[]
                for m in range(3):
                    for n in range(3):
                        if board[k+m][l+n] not in box:
                            box.append(board[k+m][l+n])
                        else :
                            if board[k+m][l+n]==".":
                                continue
                            else:    
                                return False
        return True

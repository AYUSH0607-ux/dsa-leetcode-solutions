class Solution(object):
    def searchMatrix(self, matrix, target):
        m=len(matrix)
        n=len(matrix[0])
        first=0
        last=m*n-1
        state=False
        while first<=last:
            mid=(first+last)//2
            row=mid//n
            col=mid%n
            if matrix[row][col]==target:
                return True
            elif matrix[row][col]<target:
                first=mid+1
            else:
                last=mid-1
        return False                
                    


        
